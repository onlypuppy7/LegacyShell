id":"g-moved","block":{"mesh":"shipyard.crate-wood.full","x":12,"y":0,"z":26},"to":{"type":"offset","x":0,"y":0.5,"z":-5},"power":{"id":"plate","when":"moved"},"look":{"color":0,"pad":true,"puff":true,"off":"dim"}},{"id":"g-end","block":{"mesh":"shipyard.crate-wood.full","x":15,"y":0,"z":26},"to":{"type":"offset","x":0,"y":0.5,"z":-5},"power":{"id":"plate","when":"end"},"look":{"color":3,"pad":true,"puff":true,"off":"dim","offColor":5}},{"id":"g-start","block":{"mesh":"shipyard.crate-wood.full","x":18,"y":0,"z":26},"to":{"type":"offset","x":0,"y":0.5,"z":-5},"power":{"id":"plate","when":"start"},"look":{"color":1,"pad":true,"puff":true,"off":"hide"}},{"id":"g-disk","block":{"mesh":"shipyard.crate-wood.full","x":23,"y":0,"z":22},"to":{"type":"point","x":28.5,"y":1.5,"z":26.5,"facing":0},"look":{"color":4,"pad":true,"puff":true}},{"id":"g-lift","block":{"mesh":"shipyard.crate-wood.full","x":12,"y":0,"z":30},"to":{"type":"point","x":16.5,"y":1.03,"z":30.5,"facing":0},"look":{"color":2,"pad":true,"puff":true}}],"signs":[{"block":{"mesh":"SIGNSTAND.wood.mesh","x":15,"y":1,"z":12},"text":"TELEPORTER SHOWCASE\nColoured rings are pads. Walk into one from outside to be sent. Every station has its own signs.","color":"#fff2c6","align":"center","range":6},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":13,"y":1,"z":12},"text":"THE RULE\nA pad sends what comes IN. Land inside one and you stay put until you step out and back in.","color":"#fff2c6","align":"center","range":6},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":15,"y":1,"z":18},"text":"STATIONS\nA two way\nB speed\nC point and offset\nD cube faces\nE who is sent\nF timing\nG power","color":"#fff2c6","align":"center","range":6},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":4,"y":1,"z":5},"text":"A: TWO WAY\nStep in and the twin pad sends you out. Your view swings round with you. Step out and back in over there to return.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":9,"y":1,"z":10},"text":"A: THE TWIN\nThe pads face 45 and 225, so every trip turns your view half way round.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":11,"y":1,"z":5},"text":"B1: STOP\nYour speed is killed dead on arrival. Run in as fast as you like, you land standing still.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":14,"y":1,"z":5},"text":"B2: TURN\nYou keep your speed, but it swings 90 degrees with the exit. Your view goes with it.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":17,"y":1,"z":5},"text":"B3: LAUNCH\nYou are fired out at speed 14 whatever you ran in at. Your view is left alone.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":21,"y":1,"z":3},"text":"C1: POINT\nSent to an exact spot in the map, up on the platform. Your view snaps to the way the exit faces.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":21,"y":1,"z":8},"text":"C2: OFFSET\nSent 4 across, 4 and a half up and 1 along from this very block. Same platform, but it follows the pad if the map moves.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":26,"y":5,"z":6},"text":"C: UP HERE\nNo ladders, no stairs: the only way up is a pad. Jump off to try again.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":10,"y":1,"z":14},"text":"D: A CUBE OF PADS\nOne on every face. West sends to north, north to east, east to south, south to the top, and the top back to west. Walk into a face to start.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":11,"y":1,"z":12},"text":"D: SPUN GATE\nThis zone is a thin slab turned 45 degrees with SPIN. Walk across it to be sent.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":10,"y":1,"z":16},"text":"D: UNDER THE BLOCK\nThis pad is on the underside of the block (side bottom). Stand under it to be sent up to the cube.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":1,"y":1,"z":20},"text":"E: WHO IS SENT\nEach pad has a guest list: blue, red, grenades, shots. Anything else walks straight through.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":3,"y":1,"z":20},"text":"E1: BLUE ONLY\nBlue eggs go up to the ledge. Red walks over it. Needs the Teams mode.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":5,"y":1,"z":20},"text":"E2: RED ONLY\nThe same for red. Blue walks straight over.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":7,"y":1,"z":20},"text":"E3: GRENADES ONLY\nEggs are ignored. Throw a grenade at it and the grenade is sent up to the ledge.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":9,"y":1,"z":20},"text":"E4: SHOTS ONLY\nShoot through the ring and the bullet comes out at the ledge.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":20,"y":1,"z":12},"text":"F1: CHARGE\nStand in the ring for 2 seconds. Step out early and the count starts again.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":20,"y":1,"z":15},"text":"F2: KEEP POSITION\nYou come out as far off the middle as you went in. Go in near an edge and you land near the same edge.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":22,"y":1,"z":18},"text":"F3: COOLDOWN\nThese two swap you, but each rests for 4 seconds after sending. Step back in too soon and nothing happens.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":17,"y":1,"z":23},"text":"G: POWER\nStand on the plate to switch the pads wired to it. It stays down once pressed. A dim ring is a pad that is off.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":11,"y":1,"z":25},"text":"G1: ONCE MOVED\nOff until the plate has started to go down, then on. Dim ring when off.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":14,"y":1,"z":25},"text":"G2: WHILE DOWN\nOn only when the plate is right down. Its off look is a dim coral ring.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":17,"y":1,"z":25},"text":"G3: UNTIL PRESSED\nOn at first, off the moment the plate moves. Its off look is hidden, so it just vanishes.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":21,"y":1,"z":22},"text":"G4: SPINNING DISK\nSent onto a block that spins. Its spin carries you round with it.","color":"#fff2c6","align":"center","range":5},{"block":{"mesh":"SIGNSTAND.wood.mesh","x":11,"y":1,"z":28},"text":"G5: LIFT\nSent onto a lift. Stand on it and it rises 4 blocks. Step off and it sinks back.","color":"#fff2c6","align":"center","range":5}]},"data":{"shipyard.crate-wood.full":[{"x":0,"y":0,"z":0},{"x":0,"y":0,"z":1},{"x":0,"y":0,"z":2},{"x":0,"y":0,"z":3},{"x":0,"y":0,"z":4},{"x":0,"y":0,"z":5},{"x":0,"y":0,"z":6},{"x":0,"y":0,"z":7},{"x":0,"y":0,"z":8},{"x":0,"y":0,"z":9},{"x":0,"y":0,"z":10},{"x":0,"y":0,"z":11},{"x":0,"y":0,"z":12},{"x":0,"y":0,"z":13},{"x":0,"y":0,"z":14},{"x":0,"y":0,"z":15},{"x":0,"y":0,"z":16},{"x":0,"y":0,"z":17},{"x":0,"y":0,"z":18},{"x":0,"y":0,"z":19},{"x":0,"y":0,"z":20},{"x":0,"y":0,"z":21},{"x":0,"y":0,"z":22},{"x":0,"y":0,"z":23},{"x":0,"y":0,"z":24},{"x":0,"y":0,"z":25},{"x":0,"y":0,"z":26},{"x":0,"y":0,"z":27},{"x":0,"y":0,"z":28},{"x":0,"y":0,"z":29},{"x":0,"y":0,"z":30},{"x":0,"y":0,"z":31},{"x":0,"y":0,"z":32},{"x":1,"y":0,"z":0},{"x":1,"y":0,"z":1},{"x":1,"y":0,"z":2},{"x":1,"y":0,"z":3},{"x":1,"y":0,"z":4},{"x":1,"y":0,"z":5},{"x":1,"y":0,"z":6},{"x":1,"y":0,"z":7},{"x":1,"y":0,"z":8},